{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"school.schema.json",
  "type":"object",
  "required":["school_id","domain","name","scope","source_ids","status"],
  "properties":{
    "school_id":{"type":"string","minLength":1},
    "domain":{"enum":["ziwei","bazi","qimen","liuyao","liuren","fengshui","common"]},
    "name":{"type":"string","minLength":1},
    "scope":{"type":"array","minItems":1,"items":{"enum":["STRUCTURE","SELECTION","INTERPRETATION"]}},
    "source_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "status":{"enum":["CANDIDATE","DOCUMENTED","CONFIGURABLE","DEFAULT_SUPPORTED","UNSUPPORTED"]},
    "parent_school_id":{"type":["string","null"]},
    "notes":{"type":"string"}
  },
  "additionalProperties":true
}
