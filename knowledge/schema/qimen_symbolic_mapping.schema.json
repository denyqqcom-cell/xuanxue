{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qimen_symbolic_mapping.schema.json",
  "title": "Qimen Symbolic Mapping Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_variable",
    "candidate_symbolic_role",
    "symbol_type",
    "symbol_value",
    "plate_layer",
    "palace",
    "dun_mode",
    "readback_status",
    "source_method_basis",
    "plate_layer_semantics",
    "semantics_status",
    "alternatives",
    "boundary",
    "failure_condition",
    "instance_collapse_blocked"
  ],
  "properties": {
    "world_variable": {"type": "string", "minLength": 1},
    "candidate_symbolic_role": {"type": "string", "minLength": 1},
    "symbol_type": {"type": "string", "minLength": 1},
    "symbol_value": {"type": "string", "minLength": 1},
    "plate_layer": {
      "enum": ["SKY_PLATE", "EARTH_PLATE", "OTHER_EXPLICIT_LAYER", "NOT_APPLICABLE", "UNRESOLVED"]
    },
    "palace": {"type": "string", "minLength": 1},
    "dun_mode": {
      "enum": ["YANG_DUN", "YIN_DUN", "NOT_APPLICABLE", "UNRESOLVED"]
    },
    "readback_status": {
      "enum": ["VERIFIED", "SINGLE_READ", "CONTESTED", "NOT_APPLICABLE"]
    },
    "source_method_basis": {"type": "string", "minLength": 1},
    "plate_layer_semantics": {"type": "string", "minLength": 1},
    "semantics_status": {
      "enum": ["SOURCE_LOCAL", "UNRESOLVED", "NOT_APPLICABLE"]
    },
    "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "boundary": {"type": "string", "minLength": 1},
    "failure_condition": {"type": "string", "minLength": 1},
    "instance_collapse_blocked": {"const": true}
  }
}
