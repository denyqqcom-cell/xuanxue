{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"claim.schema.json",
  "type":"object",
  "required":["claim_id","domain","layer","statement","source_ids","source_locations","school_ids","evidence_grade","status","implementation_ready","conflicts_with"],
  "properties":{
    "claim_id":{"type":"string","minLength":1},
    "domain":{"enum":["ziwei","bazi","qimen","liuyao","liuren","fengshui","common"]},
    "layer":{"enum":["STRUCTURE","SELECTION","INTERPRETATION"]},
    "statement":{"type":"string","minLength":1},
    "conditions":{"type":"object"},
    "inputs":{"type":"array"},
    "outputs":{"type":"array"},
    "source_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "source_locations":{"type":"array","minItems":1,"items":{"type":"string"}},
    "school_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_grade":{"enum":["A","B","C","D","MODEL_KNOWLEDGE_ONLY"]},
    "status":{"enum":["EXTRACTED","CROSS_VERIFIED","CONFLICTED","FIXTURE_SUPPORTED","ENGINE_VERIFIED","REJECTED","NOT_READY"]},
    "implementation_ready":{"type":"boolean"},
    "conflicts_with":{"type":"array","items":{"type":"string"}},
    "copyright_class":{"enum":["DERIVED_FACT_SAFE","RESEARCH_ONLY","REVIEW_REQUIRED"]},
    "notes":{"type":"string"}
  },
  "additionalProperties":true
}
