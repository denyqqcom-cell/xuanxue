{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deep_source_distillate.schema.json",
  "type": "object",
  "required": [
    "distillate_id",
    "source_id",
    "work_id",
    "domain",
    "distillation_scope",
    "reading_ref",
    "canonical_sha256",
    "source_anchors",
    "course_family_id",
    "course_role",
    "independence_policy",
    "prior_distillate_refs",
    "evidence_reaudit_coverage",
    "source_credit",
    "empirical_credit",
    "essence",
    "method_map",
    "applicability_constraints",
    "source_limitations",
    "conflicts_and_tensions",
    "anti_patterns",
    "model_updates",
    "testable_hypotheses",
    "excluded_from_operational_use",
    "claim_extraction_blocked",
    "acceptance_status",
    "distillation_status",
    "review_status",
    "copyright_class"
  ],
  "properties": {
    "distillate_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["ziwei", "bazi", "qimen", "liuyao", "liuren", "fengshui"]},
    "distillation_scope": {"const": "DEEP_SOURCE_BOOK"},
    "reading_ref": {"type": "string", "minLength": 1},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "course_family_id": {"type": ["string", "null"]},
    "course_role": {"type": ["string", "null"], "enum": ["FOUNDATION", "ADVANCED_EXTENSION", "SYNOPSIS_COMPENDIUM", "SIBLING_WORK", "UNKNOWN", null]},
    "independence_policy": {"enum": ["DEFAULT", "COURSE_FAMILY_SINGLE_VOTE"]},
    "prior_distillate_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_reaudit_coverage": {"enum": ["NOT_APPLICABLE", "PARTIAL", "COMPLETE"]},
    "source_credit": {"const": "FULL_SOURCE_VISUAL_REVIEWED"},
    "empirical_credit": {"const": "NONE"},
    "essence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "method_map": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "applicability_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "conflicts_and_tensions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "anti_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model_updates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "testable_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "statement", "freeze_requirements", "failure_condition", "status"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "freeze_requirements": {"type": "string", "minLength": 1},
          "failure_condition": {"type": "string", "minLength": 1},
          "status": {"const": "UNTESTED"}
        },
        "additionalProperties": false
      }
    },
    "excluded_from_operational_use": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_extraction_blocked": {"const": true},
    "acceptance_status": {"const": "K2B_SOURCE_REVIEW_ACCEPTED"},
    "distillation_status": {"const": "REVIEWED"},
    "review_status": {"const": "REVIEWED"},
    "copyright_class": {"const": "DERIVED_SYNTHESIS_SAFE"}
  },
  "additionalProperties": false
}
