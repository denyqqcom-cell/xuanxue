{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_stance.schema.json",
  "type": "object",
  "required": [
    "stance_id", "source_id", "work_id", "canonical_sha256", "topic_key", "stance",
    "evidence_locators", "stance_basis", "stance_precedence", "supersedes_stance_ids",
    "author_method_pool_eligible", "empirical_credit", "claim_extraction_blocked", "review_status"
  ],
  "properties": {
    "stance_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "topic_key": {"type": "string", "minLength": 1},
    "stance": {"enum": ["SOURCE_REPORTS", "SOURCE_ENDORSES", "SOURCE_REJECTS", "SOURCE_UNCERTAIN"]},
    "evidence_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^pdf:p[1-9][0-9]*$"}},
    "stance_basis": {"enum": ["VISUAL_PAGE", "TEXT_LAYER"]},
    "stance_precedence": {"type": "integer", "minimum": 0},
    "supersedes_stance_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "author_method_pool_eligible": {"type": "boolean"},
    "empirical_credit": {"const": "NONE"},
    "claim_extraction_blocked": {"const": true},
    "review_status": {"const": "REVIEWED"}
  },
  "additionalProperties": false
}
