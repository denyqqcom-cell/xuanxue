{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qimen_tbv_review.schema.json",
  "title": "K2 Qimen Theory-Boundary-Validation Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "unit_type",
    "unit_id",
    "title",
    "source_refs",
    "theory_core",
    "boundary_context",
    "validation",
    "universalization_status",
    "operational_status",
    "scenario_contribution",
    "falsification_requirements",
    "source_anchor_refs",
    "review_status",
    "claim_extraction_blocked",
    "empirical_credit"
  ],
  "properties": {
    "schema_version": {"const": "k2-qimen-tbv-review-v1"},
    "review_id": {"type": "string", "pattern": "^QTBV-[0-9]{4}$"},
    "unit_type": {"enum": ["DEEP_SOURCE", "WORK_FAMILY"]},
    "unit_id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 3},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "theory_core": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 12}},
    "boundary_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_domains", "method_layers", "role_frames", "temporal_models", "source_school_context", "prerequisites", "exclusions", "context_status"],
      "properties": {
        "question_domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "method_layers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "role_frames": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "temporal_models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_school_context": {"type": "string", "minLength": 12},
        "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "context_status": {"enum": ["EXPLICIT", "PARTIAL", "UNCLEAR"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_credit", "structure_credit", "method_credit", "empirical_credit", "validation_limits"],
      "properties": {
        "source_credit": {"enum": ["FULL_SOURCE_VISUAL_REVIEWED", "FULL_WORK_FAMILY_REVIEWED"]},
        "structure_credit": {"enum": ["STRONG", "CANDIDATE", "NOT_TESTED"]},
        "method_credit": {"enum": ["STRONG", "CANDIDATE", "NOT_TESTED"]},
        "empirical_credit": {"const": "NONE"},
        "validation_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}}
      }
    },
    "universalization_status": {"const": "BLOCKED"},
    "operational_status": {"enum": ["SOURCE_LOCAL_CANDIDATE", "BOUNDARY_ONLY", "MIXED_STANCE_HOLD", "HISTORICAL_ONLY", "HOLD"]},
    "scenario_contribution": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}},
    "falsification_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}},
    "source_anchor_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
    "review_status": {"const": "REVIEWED"},
    "claim_extraction_blocked": {"const": true},
    "empirical_credit": {"const": "NONE"}
  }
}
