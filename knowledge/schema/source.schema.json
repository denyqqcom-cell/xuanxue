{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"source.schema.json",
  "type":"object",
  "required":["source_id","domain","title","source_type","era","readability","copyright","local_only","status"],
  "properties":{
    "source_id":{"type":"string","minLength":1},
    "domain":{"enum":["ziwei","bazi","qimen","liuyao","liuren","fengshui","common"]},
    "knowledge_domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["ziwei","bazi","qimen","liuyao","liuren","fengshui","common","OUT_OF_SCOPE","UNKNOWN"]}},
    "domain_basis":{"enum":["TITLE_FILENAME","CONTENT_VERIFIED","MANUAL_VERIFIED","PROJECT_CODE_PATH","UNKNOWN"]},
    "domain_evidence":{"type":["string","null"],"maxLength":240},
    "title":{"type":"string","minLength":1},
    "author":{"type":["string","null"]},
    "author_basis":{"enum":["FILENAME","EMBEDDED_METADATA","TITLE_PAGE","MANUAL_VERIFIED","UNKNOWN"]},
    "author_evidence":{"type":["string","null"],"maxLength":240},
    "source_type":{"enum":["BOOK","COURSE","ANCIENT_TEXT","ARTICLE","NOTE","CODE","CASE_COLLECTION","OTHER"]},
    "era":{"enum":["ANCIENT","PRE_MODERN","MODERN","UNKNOWN"]},
    "edition":{"type":["string","null"]},
    "file_sha256":{"type":["string","null"]},
    "pages":{"type":["integer","null"],"minimum":1},
    "pages_basis":{"enum":["PDF_PAGE_COUNT","DOCUMENT_PAGE_COUNT","MANUAL_VERIFIED","UNKNOWN"]},
    "readability":{"enum":["TEXT_OK","SCAN","OCR_WEAK","OCR_FAIL","UNOPENED","METADATA_ONLY"]},
    "school_ids":{"type":"array","items":{"type":"string"}},
    "school_basis":{"enum":["FILENAME","TITLE_PAGE","CONTENT_VERIFIED","MANUAL_VERIFIED","UNKNOWN"]},
    "school_evidence":{"type":["string","null"],"maxLength":240},
    "evidence_role":{"enum":["TEXTUAL_SOURCE","SECONDARY_NOTE","IMPLEMENTATION_EVIDENCE","AUXILIARY_INDEX"]},
    "copyright":{"enum":["PUBLIC_DOMAIN_TEXT_ONLY","LICENSED","RESEARCH_ONLY","UNKNOWN","FORBIDDEN_TO_PACKAGE"]},
    "local_only":{"type":"boolean"},
    "packaged":{"type":"boolean"},
    "record_scope":{"type":"string"},
    "status":{"enum":["DISCOVERED","INDEXED","PARTIALLY_READ","READ","DUPLICATE","BLOCKED"]},
    "duplicate_of":{"type":["string","null"]},
    "notes":{"type":"string"}
  },
  "additionalProperties":true
}
